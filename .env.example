# Frontend Environment Variables

# Backend API Configuration
# Points to the backend API server
# Local development: http://localhost:8020/api/v1
# Production: https://your-api-domain.com/api/v1
NEXT_PUBLIC_API_URL=http://localhost:8020/api/v1

# Public Playground URL (external TTS demo — shown when Google sign-in needs a referral code)
# Example: https://landuvo.345321.xyz/playground
NEXT_PUBLIC_PLAYGROUND_URL=

# Firebase Authentication Configuration
# Get these values from Firebase Console:
# 1. Go to https://console.firebase.google.com
# 2. Select your project (voiv-f4391)
# 3. Click gear icon (Project Settings) → Your apps
# 4. Select or create a web app
# 5. Copy the configuration object values below

# Firebase API Key - identifies the project and enables API access
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key

# Firebase Auth Domain - used for authentication redirects
# Format: {project-id}.firebaseapp.com
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com

# Firebase Project ID - uniquely identifies your Firebase project
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id

# Firebase App ID - identifies the Firebase app instance
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id

# Notes:
# - All NEXT_PUBLIC_* variables are safe to expose in browser code (public keys only)
# - Storage is handled via Supabase S3 (backend only) - no Firebase Storage needed
# - Push notifications use SSE with backend (not Firebase Cloud Messaging)
# - Never commit .env.local (it's in .gitignore)
